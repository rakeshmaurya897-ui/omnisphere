{
  "buildCommand": "cd src/frontend && pnpm install && pnpm run build",
  "outputDirectory": "src/frontend/dist",
  "functions": {
    "api": "src/backend/api/*.js"
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}